{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "src/main/resources/static",
  "rewrites": [
    {
      "source": "/v1/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|v1/api/).*)",
      "destination": "/index.html"
    }
  ]
}
